{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{CLAUDE.md,core/*.css,core/*.md,plantillas/*.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/presentaciones/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index"
    }
  ]
}
