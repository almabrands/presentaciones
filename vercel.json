{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{CLAUDE.md,core/*.css,core/*.md,plantillas/*.html}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/presentaciones/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/plantillas/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/media/(.*)",
      "dest": "/api/index"
    }
  ]
}
