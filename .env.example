# ── IA ──
# Desarrollo local con tu cuenta de Claude Code (por defecto):
AI_PROVIDER=claude-code
# AI_MODEL=claude-opus-5-5
# Varias cuentas (si una llega a su límite, se usa la siguiente):
# CLAUDE_PROFILES=default,~/.claude-gmail

# Producción (Vercel) con API de Anthropic:
# AI_PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# ── Supabase (producción) ──
# Obtener en: https://app.supabase.com → proyecto → Settings → API
# SUPABASE_URL=https://<tu-proyecto>.supabase.co
# SUPABASE_ANON_KEY=eyJ...           ← clave anon/public
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   ← solo para seed.js (nunca en frontend)

# ── Servidor local ──
# PORT=5177
